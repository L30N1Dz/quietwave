# ============================================================
#  QUIETWAVE — station configuration
#  Copy to .env and fill in. .env is gitignored; never commit it.
# ============================================================

# ---- Twilio ------------------------------------------------
# Console -> Account -> API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# ---- Public origin ----------------------------------------
# The exact public https origin Twilio reaches this app on, no trailing path.
# Twilio signature validation is built from THIS value plus the known route
# path -- never from the proxied inbound request. Getting this wrong is the
# number one cause of "403 bad signature" on inbound messages.
PUBLIC_BASE_URL=https://text.example.com

# ---- Station access ---------------------------------------
# The passphrase typed into the login screen. Long, boring, memorable.
APP_PASSPHRASE=change-me-to-something-long
# Signs the session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-real-one

# ---- Storage ----------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=quietwave
# "mongo" for real use. "memory" is a throwaway in-process store for demos
# and tests -- everything is lost on restart.
QUIETWAVE_STORE=mongo
# Where downloaded MMS attachments land on disk.
QUIETWAVE_MEDIA_ROOT=./data/media

# ---- Interface --------------------------------------------
# Default theme: quietwave | relay-nine | emberlink | neonwire
QUIETWAVE_THEME=quietwave
QUIETWAVE_HOST=127.0.0.1
QUIETWAVE_PORT=8090
# How often the client checks for new traffic, in milliseconds.
QUIETWAVE_POLL_INTERVAL_MS=5000

# ---- Behaviour knobs --------------------------------------
# Only ever set false for local development without Twilio. Never in production.
QUIETWAVE_VALIDATE_TWILIO_SIGNATURE=true
# Country code assumed when a number is typed without one.
QUIETWAVE_DEFAULT_COUNTRY_CODE=1
# Outbound attachments are served to Twilio from an unguessable public URL
# that stops working after this many hours.
QUIETWAVE_OUTBOUND_MEDIA_TTL_HOURS=24
QUIETWAVE_SESSION_TTL_DAYS=180
# Set false only if you are running plain http on localhost.
QUIETWAVE_COOKIE_SECURE=true
